# an1 — 二级结构 DSSP + Ramachandran phi/psi（fig13/14/27 数据源）
# 模板占位符: {PARM7} {TRAJIN_BLOCK} {PROT_RANGE} {RAW}
parm {PARM7}
{TRAJIN_BLOCK}
autoimage
dssp PROTEIN :{PROT_RANGE} out {RAW}/dssp.dat sumout {RAW}/dssp_sum.dat
multidihedral phi resrange {PROT_RANGE} out {RAW}/phi.dat
multidihedral psi resrange {PROT_RANGE} out {RAW}/psi.dat
run
quit
