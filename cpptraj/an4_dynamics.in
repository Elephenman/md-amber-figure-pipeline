# an4 — ssDNA 弯曲角 (5'端-中点-3'端 C3' 三点角) + 端距补充（fig29 数据源; 需要核酸）
# {DNA_MID} = (DNA_LO+DNA_HI+1)/2 中点残基; 三点角 >180 无意义时 cpptraj 取内角 (0-180)
# 模板占位符: {PARM7} {TRAJIN_BLOCK} {DNA_LO} {DNA_MID} {DNA_HI} {RAW}
parm {PARM7}
{TRAJIN_BLOCK}
angle DNA_BEND :{DNA_LO}@C3' :{DNA_MID}@C3' :{DNA_HI}@C3' out {RAW}/dna_bend.dat
run
quit
