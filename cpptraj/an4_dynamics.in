parm /home/u22607007/md/topol/WT__S1/vWT__S1.parm7
trajin /home/u22607007/md/out/WT__S1/prod.nc 1 1500 1
# DCCM: 蛋白 CA 原子运动互相关矩阵 (254x254)
matrix correl name DC :1-254@CA out /home/u22607007/md/out/WT__S1/dccm_prot.dat
# ssDNA 弯曲角: 5'端(nt1) - 中间(nt13) - 3'端(nt24) C3' 三点角
angle DNA_BEND :255@C3' :267@C3' :278@C3' out /home/u22607007/md/out/WT__S1/dna_bend.dat
run
quit
