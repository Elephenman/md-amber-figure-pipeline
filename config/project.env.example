# ============================================================================
# md-amber-figure-pipeline  project.env  — 全部可调参数（通常不用动默认值）
# 用法: 复制为 project.env 放到工作目录，或直接运行 ./md_easy.sh 交互生成。
#   本文件只做文档；md_easy.sh 交互问答会生成一份带你的值的 project.env。
# 阶段: 0 环境体检 → 1 tleap 拓扑 → 2 约束(DISANG/Mn) → 3 MD(min1→min2→heat→equil→prod)
#       → 4 cpptraj 数据采集 → 5 MM-PBSA(可选) → 6 一键 30 图
# ============================================================================

# ---------- 体系 ----------
SYSTEM="sys1"                     # 体系名（产物目录名 topol/out/results 均用它）
INPUT_PDB=""                      # 复合物 PDB（蛋白+核酸，可含金属 HETATM）。必填。
PROD_NS="150"                     # 生产时长 ns（每重复）
NREP="1"                          # 重复数
TEMP="300.0"                      # 模拟温度 K

# ---------- 力场 / 溶剂 ----------
PROT_FF="ff19SB"                  # 蛋白: ff19SB(默认) 或 ff14SB
DNA_FF="OL15"                     # 核酸: OL15(默认，bsc1 修正系)
WAT_FF="TIP3P"                    # 水: TIP3P
BOX_DIST="12.0"                   # 溶剂化截断距离 Å（溶质到盒子边）
# 离子: 固定用 Amber 自带 12-6-4 Na+/Cl- (frcmod.ions1lm_1264_tip3p) + 自动中和

# ---------- 金属离子（Mn2+ 型配位体系专用，非金属体系保持 METAL=none） ----------
# auto = PDB 含 MN HETATM 则按金属体系处理；none = 无金属（跳过 DISANG/Mn 图）
METAL="auto"
FRCMOD=""                         # 金属 frcmod；留空 = 仓库自带 ff/mn_cm12-6.frcmod
# 金属配位 HIS 必须 ε-去质子化(HID)：stage1 自动探测 Mn 3.0 Å 内 HIS 并改写为 HID。
# 配位残基非 His/Glu 的体系需手工给 make_restraints.py 提供配位原子集。

# ---------- 约束方案（默认值即项目验证结论，勿轻易改） ----------
# heat   : NVT 0→TEMP, 骨架+金属 wt=10
# equil  : NPT, 骨架 wt=2
# prod   : NPT 300 K, ntr=0 自由动力学（2026-09-01 修订：骨架约束 1.0 会把 RMSD 钉死到
#          0.39 Å 造成病态采样，必须自由）+ 仅 Mn 配位 flat-bottom DISANG(2.1-2.5 Å, rk=10)
MIN_WT="25.0" HEAT_WT="10.0" EQUIL_WT="2.0"

# ---------- 运行 ----------
ENGINE="auto"                     # auto: pmemd.cuda(GPU) → pmemd(CPU) 兜底
# 集群 sbatch 包装见 docs/PIPELINE_ARCHITECTURE.md（登录节点一键依赖链）

# ---------- 后处理 ----------
DO_MMPBSA="no"                    # yes=跑 MM-PBSA 逐残基分解（CPU 慢，需要 MMPBSA.py）
DO_FIGS="yes"                     # yes=采集完成后一键出 30 图
PLOT_DT_NS="0.1"                  # 轨迹帧间隔 ns（prod 默认每 100 ps 一帧 → 0.1）
# an3 关键氢键距离时序(fig22) 用: "名字=残基1:原子1=残基2:原子2" 竖线分隔，留空则跳过 an3
# 例(数字为 parm7 残基号): "S167_dG17=146:OG=271:O6|N127_dG17=106:ND2=271:O4'"
HBOND_PAIRS=""
